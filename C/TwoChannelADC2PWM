#include <stdio.h>
#include <stdlib.h>
#include <pic18f45k22.h>
#include <htc.h>

#define _XTAL_FREQ 8000000

#pragma config FOSC = HSHP
#pragma config WDTEN = OFF

unsigned int value[2] = {0, 0};
unsigned char an_cnt = 0;
unsigned char an_list[2] = {0, 1};

void(main)
{
    ANSELA = 0x03;
    TRISA = 0xFF;

    ANSELC = 0x00;
    TRISC = 0xF9;

    ANSELE = 0x00;
    TRISE = 0x7F;

    ADCON2 = 0xA1;
    ADCON1 = 0X00;

    ADCON0bits.CHS = anlist[0];
    ADCON0bits.ADON = 1;
    GODONE = 1;

    T2CON = 0xC3;
    PR2 = 255;
    CCP1CON = 0x0C;
    CCP2CON = 0x0C;

    while (1)
    {
        if (!GODONE)
        {
            value[an_cnt] = ((long)ADRESH * 256 + ADRESL);
            an_cnt++;
            if (an_cnt >= 2)
            {
                an_cnt = 0;
            }
            ADCON0bits.CHS = an_list[an_cnt];
            GODONE = 1;
        }
        CCPR1L = value[0] >> 2; // value[10] 10 bit olduğundan, 2 sağa kaydırarak 8 bit yapıyor
        CCP1CON = (CCP1CON & 0xCF) + ((value[0] & 0x0003) << 4)
                  /*
                  CCP1CON & 0xCF = 0x0C & 0xCF
                                 = 0000 1100
                                   1100 1111
                                  *---------
                                   0000 1100 This way bit 4 and 5 are cleared and bit2 and bit3 resembles
                                             PWM mode and PWM mode is also preserved
                  value[0] & 0x0003 << 4 = first of all & operator have more priority than << left shift
                  value[0] & 0x0003 = 0b 00 00000011 & 0b 10 01100101
                                    = 0b 00 00000011
                                      0b 10 01100101
                                     *--------------
                                      0b 00 00000001
                  0b00000001 << 4 = 0b00010000

                  END RESULT = CCP1CON = 0000 1100 + 0001 0000
                                       = 0001 1100

                  */

                  CCPR2L = value[1] >> 2;
        CCP2CON = (CCP2CON & 0xCF) + (value[0] & 0x0003 << 4)
    }
}

